# Optional overrides for docker compose. Copy to .env and adjust if a port is taken.
# Docker Compose reads .env automatically. No secrets belong here.

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# URL the browser uses to reach the backend (must match BACKEND_PORT)
API_BASE_URL=http://localhost:8000

# Origins allowed to call the backend from a browser (comma-separated, must match FRONTEND_PORT)
CORS_ORIGINS=http://localhost:3000
